# ==========================================
# DATABASE CONNECTION (Supabase / PostgreSQL)
# ==========================================
# Direct PostgreSQL connection string for Drizzle ORM / Migrations
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ==========================================
# SUPABASE CONFIGURATION
# ==========================
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anonymous Public Key
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Key (Server-only / Admin tasks)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================
# AI INTEGRATION
# ==========================================
# Google Gemini API Key for AI Financial Advisor & OCR
GEMINI_API_KEY="your-gemini-api-key"

# Optional fallback gateway key
AI_GATEWAY_API_KEY=""

# ==========================================
# APPLICATION URL CONFIGURATION
# ==========================================
# Base public URL for Auth redirects & callback URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
